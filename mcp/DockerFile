# Dockerfile
FROM openjdk:17-jdk-slim

LABEL maintainer="Your Organization"
LABEL description="PostgreSQL MCP Server"
LABEL version="1.0.0"

# Install PostgreSQL client (for utilities)
RUN apt-get update && \
    apt-get install -y postgresql-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the built JAR file
COPY build/libs/postgres-mcp-*.jar app.jar

# Create non-root user
RUN addgroup --system mcpuser && adduser --system --group mcpuser
RUN chown -R mcpuser:mcpuser /app
USER mcpuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/mcp/health || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]