# PostgreSQL MCP Server Environment Configuration
# Copy this file to .env and update values for your environment

# ===========================================
# ENCRYPTION KEYS (REQUIRED - CHANGE THESE!)
# ===========================================
# Generate secure keys using: openssl rand -hex 32
ENCRYPTION_PASSWORD=your-secure-encryption-password-here-minimum-32-chars
ENCRYPTION_SALT=your-secure-salt-here-minimum-16-chars

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Main application database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mcp_server
DB_USERNAME=mcp_user
DB_PASSWORD=your-secure-db-password-here

# Development database (if different)
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=mcp_server_dev
DEV_DB_USERNAME=mcp_dev_user
DEV_DB_PASSWORD=your-dev-password-here

# Client database configuration
CLIENT_DB_NAME=retail_db
CLIENT_DB_HOST=localhost
CLIENT_DB_PORT=5432
CLIENT_DB_DATABASE=mcp_server
CLIENT_DB_USERNAME=mcp_user
CLIENT_DB_PASSWORD=your-client-db-password-here
CLIENT_DB_DESCRIPTION="Retail database for storing product, customer, order data"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Spring profile (development, production, test)
SPRING_PROFILES_ACTIVE=development

# Server port
SERVER_PORT=8081

# ===========================================
# GENERATION COMMANDS
# ===========================================
# Generate encryption password: openssl rand -hex 32
# Generate salt: openssl rand -hex 16
# Generate database password: openssl rand -base64 32
